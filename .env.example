# ==============================================================================
# AgriTrustGeoAgent - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your Supabase project credentials.
# NEVER commit the actual '.env' file or paste secret keys into chat.
# ==============================================================================

# --- SUPABASE CLIENT-SIDE CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API

# Your Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (Safe for browser/frontend usage; secured via PostgreSQL Row Level Security)
# (In some dashboards, this is labeled as the "anon" or "public" key)
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- SERVER-ONLY CONFIGURATION (NEVER EXPOSED TO BROWSER / CLIENT) ---
# Secret Service Role Key (STRICTLY SERVER-SIDE. Gives full admin bypass of RLS. Never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# --- APPLICATION & SERVER SETTINGS ---
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
